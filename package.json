{
  "name": "reg-score",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "reg-score": "./dist/cli.js"
  },
  "scripts": {
    "setup": "node scripts/setup-product.mjs",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "reg-score": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "harness:test": "node --test harness/__tests__/*.test.mjs",
    "harness:validate": "node harness/run-checks.mjs validate",
    "harness:report": "node harness/run-checks.mjs report",
    "validate": "npm run harness:test && npm run harness:validate && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
}
