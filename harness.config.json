    "AGENTS.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "CONTEXT.md",
    "PROJECT.md",
    "docs/incidents/LEDGER.md",
    "docs/testing/REGRESSION-CONTRACTS.md",
    "docs/verification/BOUNDARY-MATRIX.md"
  ],
  "projectChecks": []
}

