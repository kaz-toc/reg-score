{
  "schemaVersion": 1,
  "sourceRoots": ["src"],
  "sourceExtensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".py", ".go", ".rs"],
  "excludeSegments": ["node_modules", "dist", "build", "coverage", "vendor", "generated", "__tests__", "test", "tests"],
  "maxNonBlankLines": 800,
  "regressionRoot": "test-fixtures/regressions",
